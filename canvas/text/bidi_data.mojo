# Paired brackets for rule N0, from BidiBrackets.txt: six hex
# digits opening, six closing. BD16 matches brackets under
# canonical equivalence, so U+2329/U+232A are folded to their
# singleton decompositions U+3008/U+3009 here and lookups fold
# the same way -- otherwise `<a>` spelled with one and closed
# with the other fails to pair.
comptime _BRACKET_REC = 12
comptime _BRACKET_PAIRS = 63
comptime _BRACKET_TABLE = (
    "00002800002900005B00005D00007B00007D000F3A000F3B000F3C000F3D"
    "00169B00169C00204500204600207D00207E00208D00208E002308002309"
    "00230A00230B00276800276900276A00276B00276C00276D00276E00276F"
    "0027700027710027720027730027740027750027C50027C60027E60027E7"
    "0027E80027E90027EA0027EB0027EC0027ED0027EE0027EF002983002984"
    "00298500298600298700298800298900298A00298B00298C00298D002990"
    "00298F00298E002991002992002993002994002995002996002997002998"
    "0029D80029D90029DA0029DB0029FC0029FD002E22002E23002E24002E25"
    "002E26002E27002E28002E29002E55002E56002E57002E58002E59002E5A"
    "002E5B002E5C00300800300900300A00300B00300C00300D00300E00300F"
    "00301000301100301400301500301600301700301800301900301A00301B"
    "00FE5900FE5A00FE5B00FE5C00FE5D00FE5E00FF0800FF0900FF3B00FF3D"
    "00FF5B00FF5D00FF5F00FF6000FF6200FF63"
)

# The classes, in the order the table's letters encode them: 'a' is
# the first, 'b' the second, and so on. UAX #9 Table 4.
comptime _BC_L = 0
comptime _BC_R = 1
comptime _BC_AL = 2
comptime _BC_EN = 3
comptime _BC_ES = 4
comptime _BC_ET = 5
comptime _BC_AN = 6
comptime _BC_CS = 7
comptime _BC_NSM = 8
comptime _BC_BN = 9
comptime _BC_B = 10
comptime _BC_S = 11
comptime _BC_WS = 12
comptime _BC_ON = 13
comptime _BC_LRE = 14
comptime _BC_RLE = 15
comptime _BC_LRO = 16
comptime _BC_RLO = 17
comptime _BC_PDF = 18
comptime _BC_LRI = 19
comptime _BC_RLI = 20
comptime _BC_FSI = 21
comptime _BC_PDI = 22


@always_inline
def _hex6(bytes: Span[Byte, _], off: Int) -> Int:
    var v = 0
    for i in range(6):
        var c = Int(bytes[off + i])
        v = v * 16 + (c - 48 if c <= 57 else c - 55)
    return v


def bidi_class(cp: Int) -> Int:
    """The codepoint's UAX #9 bidi class.

    Binary search over `_BIDI_TABLE`'s fixed-width records. Anything
    the table does not cover is `L`, which is the default the table
    was built against.
    """
    if cp < 256:
        # A shaped glyph that a ligature or substitution produced
        # carries -1 where its codepoint was, and reaches here through
        # `is_combining_mark`. It is not a mark, and it is not an
        # index either.
        if cp < 0:
            return _BC_L
        return Int(_LATIN1.as_bytes()[cp]) - 97
    var b = _BIDI_TABLE.as_bytes()
    var lo = 0
    var hi = _BIDI_RUNS - 1
    while lo <= hi:
        var mid = (lo + hi) // 2
        var off = mid * _BIDI_REC
        if _hex6(b, off) > cp:
            hi = mid - 1
        elif _hex6(b, off + 6) < cp:
            lo = mid + 1
        else:
            return Int(b[off + 12]) - 97
    return _BC_L


@always_inline
def canonical_bracket(cp: Int) -> Int:
    """BD16 pairs brackets under canonical equivalence. Only two
    brackets have a singleton decomposition, so folding them by hand
    is the whole of it."""
    if cp == 0x2329:
        return 0x3008
    if cp == 0x232A:
        return 0x3009
    return cp


def bracket_partner(cp: Int) -> Int:
    """The other half of a paired bracket, or 0 for anything that is
    not one (rule N0). The table holds each pair once, opening first.
    """
    # Almost every ON character reaching here is punctuation, not a
    # bracket, so reject the ranges that hold none before scanning.
    if cp < 0x28:
        return 0
    if cp > 0x7D and cp < 0x0F3A:
        return 0
    if cp > 0xFF63:
        return 0
    var c = canonical_bracket(cp)
    var bb = _BRACKET_TABLE.as_bytes()
    for i in range(_BRACKET_PAIRS):
        var off = i * _BRACKET_REC
        if c == _hex6(bb, off):
            return _hex6(bb, off + 6)
        if c == _hex6(bb, off + 6):
            return _hex6(bb, off)
    return 0


def bracket_is_open(cp: Int) -> Bool:
    """Whether `cp` is the opening half of a pair."""
    var c = canonical_bracket(cp)
    var b = _BRACKET_TABLE.as_bytes()
    for i in range(_BRACKET_PAIRS):
        if c == _hex6(b, i * _BRACKET_REC):
            return True
    return False
